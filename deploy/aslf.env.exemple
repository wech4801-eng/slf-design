# Configuration du site ASLF (copiée dans /etc/aslf/aslf.env par le script d'installation)

# Adresse publique du site, sans « / » à la fin
SITE_URL=https://www.aslf-france.org

# Le site écoute seulement en local ; Caddy le publie en HTTPS
HOST=127.0.0.1
PORT=3456
TRUST_PROXY=1

# Données (articles, membres, messages, photos, sauvegardes)
DATA_DIR=/var/lib/aslf

# Nombre de jours de sauvegardes automatiques conservées, et durée de la corbeille
BACKUP_DAYS=30
TRASH_DAYS=30
