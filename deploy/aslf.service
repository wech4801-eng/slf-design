# Service systemd du site ASLF : démarre au boot, redémarre tout seul en cas de panne.
[Unit]
Description=Site de l'Association Somalilandaise de France (ASLF)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aslf
Group=aslf
WorkingDirectory=/opt/aslf
EnvironmentFile=/etc/aslf/aslf.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
TimeoutStopSec=15
# Durcissement : le site ne peut écrire que dans son dossier de données
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aslf
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
MemoryMax=512M

[Install]
WantedBy=multi-user.target
